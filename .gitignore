# Cocos Creator generated output
/build/
/temp/
/library/
/local/
/.creator/
/.cocos/

# Legacy Godot caches that may exist locally after migration
/.godot/
/.godot_user/
/.import/

# Generated native/platform output. Project-owned native/engine stays trackable.
/native/*
!/native/engine/
!/native/engine/**

# Local/editor noise
*.tmp
*.temp
*.log
*.bak
Thumbs.db
Desktop.ini

# Locally built/installed Android packages (device-test artifacts)
*.apk
*.aab

# Mobile signing secrets
.env
.env.*
*.keystore
*.jks
*.p12
